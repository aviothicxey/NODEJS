<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Upload File</title>
  <style>
    body {
      margin: 0;
      min-height: 100vh;
      display: grid;
      place-items: center;
      font-family: Arial, sans-serif;
      background: #f5f6fa;
      padding: 20px;
    }

    .card {
      width: 100%;
      max-width: 420px;
      background: #fff;
      border-radius: 10px;
      box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
      padding: 24px;
    }

    h2 {
      margin-top: 0;
    }

    button {
      margin-top: 12px;
      padding: 10px 14px;
      border: none;
      border-radius: 6px;
      background: #6c5ce7;
      color: #fff;
      cursor: pointer;
    }

    .message {
      margin-top: 12px;
      font-size: 14px;
      word-break: break-word;
    }

    a {
      color: #2d6cdf;
    }
  </style>
</head>
<body>
  <div class="card">
    <h2>Upload File</h2>
    <form id="uploadForm">
      <input type="file" name="file" accept=".jpg,.jpeg,.png,.webp,.pdf" required />
      <button type="submit">Upload</button>
    </form>
    <p id="message" class="message"></p>
  </div>

  <script>
    const form = document.getElementById("uploadForm");
    const messageEl = document.getElementById("message");

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const fileInput = form.file;
      if (!fileInput.files.length) {
        messageEl.textContent = "Please choose a file";
        return;
      }

      const data = new FormData();
      data.append("file", fileInput.files[0]);

      try {
        const res = await fetch("/api/upload/single", {
          method: "POST",
          body: data
        });

        const result = await res.json();

        if (!res.ok) {
          messageEl.textContent = result.message || "Upload failed";
          return;
        }

        messageEl.innerHTML = `Uploaded: <a href="${result.file.url}" target="_blank">${result.file.fileName}</a>`;
      } catch (err) {
        messageEl.textContent = "Upload failed";
      }
    });
  </script>
</body>
</html>
