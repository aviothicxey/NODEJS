<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Employees</title>
        <link
            href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap"
            rel="stylesheet"
        />
        <style>
            :root {
                --bg-1: #0f1324;
                --bg-2: #1c2c54;
                --card: #121826;
                --ink: #f5f7ff;
                --muted: #a7b0cc;
                --accent: #ffb347;
                --accent-2: #58d5ff;
                --danger: #ff6b6b;
                --shadow: rgba(14, 19, 36, 0.5);
            }

            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                font-family: "Space Grotesk", sans-serif;
                color: var(--ink);
                min-height: 100vh;
                background:
                    radial-gradient(circle at 20% 10%, rgba(88, 213, 255, 0.25), transparent 55%),
                    radial-gradient(circle at 80% 0%, rgba(255, 179, 71, 0.25), transparent 50%),
                    linear-gradient(160deg, var(--bg-1), var(--bg-2));
                display: flex;
                justify-content: center;
                padding: 40px 16px 64px;
            }

            .shell {
                width: min(1040px, 100%);
                display: grid;
                gap: 24px;
                animation: fadeUp 0.7s ease both;
            }

            header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 16px;
            }

            .title {
                display: grid;
                gap: 6px;
            }

            .title h1 {
                margin: 0;
                font-size: clamp(28px, 4vw, 40px);
                letter-spacing: -0.02em;
            }

            .title p {
                margin: 0;
                color: var(--muted);
            }

            nav {
                display: flex;
                gap: 10px;
                flex-wrap: wrap;
            }

            .btn {
                padding: 10px 16px;
                border-radius: 999px;
                border: 1px solid transparent;
                text-decoration: none;
                font-weight: 600;
                color: var(--bg-1);
                background: linear-gradient(120deg, var(--accent), var(--accent-2));
                box-shadow: 0 12px 24px var(--shadow);
                transition: transform 0.2s ease, box-shadow 0.2s ease;
            }

            .btn.secondary {
                background: transparent;
                color: var(--ink);
                border-color: rgba(255, 255, 255, 0.2);
                box-shadow: none;
            }

            .btn:hover {
                transform: translateY(-2px);
            }

            .card {
                background: var(--card);
                padding: 22px;
                border-radius: 24px;
                box-shadow: 0 24px 50px var(--shadow);
                border: 1px solid rgba(255, 255, 255, 0.06);
            }

            table {
                width: 100%;
                border-collapse: collapse;
                font-size: 0.95rem;
            }

            thead th {
                text-align: left;
                padding: 14px 12px;
                color: var(--muted);
                font-weight: 600;
                border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            }

            tbody td {
                padding: 14px 12px;
                border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            }

            tbody tr {
                animation: fadeUp 0.6s ease both;
            }

            .pill {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                padding: 6px 12px;
                border-radius: 999px;
                background: rgba(88, 213, 255, 0.15);
                color: var(--ink);
                font-weight: 600;
                font-size: 0.85rem;
            }

            .actions {
                display: flex;
                gap: 8px;
                flex-wrap: wrap;
            }

            .link-btn {
                padding: 6px 12px;
                border-radius: 999px;
                text-decoration: none;
                font-size: 0.85rem;
                font-weight: 600;
                border: 1px solid rgba(255, 255, 255, 0.2);
                color: var(--ink);
            }

            .link-btn.danger {
                border-color: rgba(255, 107, 107, 0.5);
                color: var(--danger);
            }

            .empty {
                text-align: center;
                color: var(--muted);
                padding: 48px 16px;
            }

            @keyframes fadeUp {
                from {
                    opacity: 0;
                    transform: translateY(16px);
                }
                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            @media (max-width: 760px) {
                table,
                thead,
                tbody,
                th,
                td,
                tr {
                    display: block;
                }

                thead {
                    display: none;
                }

                tbody tr {
                    border: 1px solid rgba(255, 255, 255, 0.08);
                    border-radius: 16px;
                    margin-bottom: 14px;
                    padding: 10px;
                }

                tbody td {
                    border: none;
                    padding: 10px;
                }

                tbody td::before {
                    content: attr(data-label);
                    display: block;
                    color: var(--muted);
                    font-size: 0.75rem;
                    text-transform: uppercase;
                    margin-bottom: 4px;
                }
            }
        </style>
    </head>
    <body>
        <div class="shell">
            <header>
                <div class="title">
                    <h1>Employee roster</h1>
                    <p>Track who is onboard, and keep details close at hand.</p>
                </div>
                <nav>
                    <a class="btn" href="/add-emp">Add employee</a>
                    <a class="btn secondary" href="/employees">Refresh list</a>
                </nav>
            </header>

            <section class="card">
                <% if (!employees || employees.length === 0) { %>
                    <div class="empty">
                        No employees yet. Add your first team member to get started.
                    </div>
                <% } else { %>
                    <table>
                        <thead>
                            <tr>
                                <th>Employee ID</th>
                                <th>Name</th>
                                <th>Username</th>
                                <th>Age</th>
                                <th>Email</th>
                                <th>Date of Joining</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% employees.forEach((employee, index) => { %>
                                <tr style="animation-delay: <%= index * 70 %>ms;">
                                    <td data-label="Employee ID"><span class="pill">#<%= employee.id %></span></td>
                                    <td data-label="Name"><%= employee.name %></td>
                                    <td data-label="Username"><%= employee.username %></td>
                                    <td data-label="Age"><%= employee.age %></td>
                                    <td data-label="Email"><%= employee.email %></td>
                                    <td data-label="Date of Joining"><%= employee.doj %></td>
                                    <td data-label="Actions">
                                        <div class="actions">
                                            <a class="link-btn" href="/edit-emp/<%= employee.id %>">Edit</a>
                                            <a class="link-btn danger" href="/delete-emp/<%= employee.id %>">Delete</a>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                <% } %>
            </section>
        </div>
    </body>
</html>
