<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Signup</title>
    <style>
        :root {
            --bg: #f4f6f8;
            --card: #ffffff;
            --text: #1f2937;
            --muted: #6b7280;
            --line: #d1d5db;
            --primary: #0f766e;
            --primary-hover: #115e59;
            --success-bg: #ecfdf5;
            --success-text: #065f46;
            --error-bg: #fef2f2;
            --error-text: #991b1b;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            display: grid;
            place-items: center;
            padding: 20px;
            font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
            color: var(--text);
            background:
                radial-gradient(circle at 20% 20%, #d9f3ef 0%, transparent 40%),
                radial-gradient(circle at 80% 80%, #f0efe4 0%, transparent 45%),
                var(--bg);
        }

        .card {
            width: min(460px, 100%);
            background: var(--card);
            border: 1px solid #e5e7eb;
            border-radius: 16px;
            box-shadow: 0 20px 45px rgba(15, 23, 42, 0.12);
            padding: 28px;
            max-height: calc(100vh - 40px);
            overflow-y: auto;
        }

        h2 {
            margin: 0 0 18px;
            text-align: center;
            font-size: 34px;
            letter-spacing: 0.2px;
        }

        .subtitle {
            margin: 0 0 22px;
            text-align: center;
            color: var(--muted);
            font-size: 14px;
        }

        .field {
            margin-bottom: 12px;
        }

        input {
            width: 100%;
            border: 1px solid var(--line);
            border-radius: 10px;
            padding: 12px 13px;
            font-size: 15px;
            color: var(--text);
            background: #fff;
            outline: none;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }

        input:focus {
            border-color: #14b8a6;
            box-shadow: 0 0 0 4px rgba(20, 184, 166, 0.15);
        }

        .file-wrap {
            border: 1px dashed #94a3b8;
            border-radius: 12px;
            padding: 10px 12px;
            background: #f8fafc;
            margin-bottom: 12px;
        }

        .file-label {
            display: block;
            font-size: 13px;
            color: var(--muted);
            margin-bottom: 8px;
        }

        .actions {
            margin-top: 6px;
        }

        button {
            width: 100%;
            border: none;
            border-radius: 10px;
            padding: 12px 14px;
            font-size: 15px;
            font-weight: 700;
            color: #fff;
            background: var(--primary);
            cursor: pointer;
            transition: background 0.2s ease, transform 0.06s ease;
        }

        button:hover {
            background: var(--primary-hover);
        }

        button:active {
            transform: translateY(1px);
        }

        .message {
            margin: 0 0 16px;
            border-radius: 10px;
            padding: 10px 12px;
            font-size: 14px;
            text-align: center;
            border: 1px solid transparent;
        }

        .message.success {
            background: var(--success-bg);
            color: var(--success-text);
            border-color: #a7f3d0;
        }

        .message.error {
            background: var(--error-bg);
            color: var(--error-text);
            border-color: #fecaca;
        }

        .footer {
            text-align: center;
            margin-top: 15px;
            font-size: 13px;
            color: #666;
        }

        .footer a {
            color: var(--primary);
            text-decoration: none;
            font-weight: bold;
        }

        .footer a:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body>
    <div class="card">
        <h2>Create Account</h2>
        <p class="subtitle">Sign up with your profile image</p>

        <% if (message) { %>
            <p class="message <%= message.toLowerCase().includes('successful') ? 'success' : 'error' %>"><%= message %></p>
        <% } %>

        <form action="/signup" enctype="multipart/form-data" method="POST">
            <div class="field">
                <input type="text" name="firstname" placeholder="First Name" required />
            </div>

            <div class="field">
                <input type="text" name="lastname" placeholder="Last Name" />
            </div>

            <div class="field">
                <input type="text" name="username" placeholder="Username" required />
            </div>

            <div class="field">
                <input type="email" name="email" placeholder="Email" required />
            </div>

            <div class="field">
                <input type="number" name="age" placeholder="Age" />
            </div>

            <div class="file-wrap">
                <label class="file-label" for="profilePic">Profile Image</label>
                <input id="profilePic" type="file" name="profilePic" accept="image/*" required />
            </div>

            <div class="field">
                <input type="password" name="password" placeholder="Password" required />
            </div>

            <div class="field">
                <input type="password" name="confirmPassword" placeholder="Retype Password" required />
            </div>

            <div class="actions">
                <button type="submit">Sign Up</button>
            </div>
        </form>

        <div class="footer">
            Already have an account? <a href="/login">Login here</a>
        </div>
    </div>
</body>
</html>